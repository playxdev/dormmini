# Copy to .env and fill in. Never commit .env
# Vite only exposes variables prefixed with VITE_ to browser code.

VITE_APP_ENV=development

VITE_APP_URL=https://dorm.playxdev.com
VITE_API_BASE_URL=https://apidorm.playxdev.com

# LIFF ID of the LINE Login channel. Public by design - not a secret.
VITE_LINE_LIFF_ID=<LIFF_ID>

# Set to 1 to run in a normal browser with mock data (no LINE required).
VITE_MOCK=0
